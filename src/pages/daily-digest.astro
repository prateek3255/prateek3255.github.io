---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Daily Digest — Zuko" noindex>
  <main class="dd">
    <header class="dd-topbar">
      <a class="dd-brand" href="/" aria-label="Zuko home"><span class="dd-mark">Z</span><span>ZUKO <i>/</i> DAILY DIGEST</span></a>
      <button id="dd-logout" class="dd-ghost" type="button" hidden>LOG OUT</button>
      <span id="dd-private" class="dd-note">PRIVATE</span>
    </header>

    <section id="dd-loading" class="dd-center" aria-live="polite">
      <p class="dd-mono dd-pulse">LOADING…</p>
    </section>

    <section id="dd-login" class="dd-center" hidden>
      <div class="dd-login">
        <p class="dd-mono dd-kicker">01 <span class="dd-rule"></span> PRIVATE PAGE</p>
        <h1>Daily <em>digest.</em></h1>
        <form id="dd-form" autocomplete="on">
          <label class="dd-mono" for="dd-password">PASSWORD</label>
          <div class="dd-field">
            <input id="dd-password" name="password" type="password" autocomplete="current-password" required autofocus />
            <button id="dd-submit" type="submit">UNLOCK <b aria-hidden="true">↗</b></button>
          </div>
          <p id="dd-login-error" class="dd-error dd-mono" role="alert" hidden></p>
        </form>
      </div>
    </section>

    <section id="dd-content" hidden>
      <div class="dd-head">
        <p class="dd-mono dd-kicker"><span id="dd-count">—</span> <span class="dd-rule"></span> <span id="dd-date">—</span></p>
        <h1>Daily <em>digest.</em></h1>
        <div class="dd-head-actions">
          <button id="dd-refresh" class="dd-ghost" type="button">REFRESH STATUS</button>
          <span id="dd-stale" class="dd-mono dd-warn" hidden>RAINDROP STATUS MAY BE OUT OF DATE</span>
        </div>
      </div>
      <div id="dd-empty" class="dd-empty" hidden>
        <p>Nothing in today’s digest yet.</p>
        <p class="dd-mono">THE 08:30 IST RUN FILLS THIS IN</p>
      </div>
      <div id="dd-groups"></div>
    </section>

    <footer class="dd-footer"><span>ZUKO</span><span>AGENT FOR PRATEEK · 2026</span></footer>
  </main>
</Layout>

<script>
  const API = (import.meta.env.PUBLIC_API_URL || 'https://agent-api.prateeksurana.me').replace(/\/$/, '');
  const $ = (id: string) => document.getElementById(id)!;
  const CATS: Record<string, string> = {
    'go': 'GO', 'backend': 'BACKEND & SYSTEMS', 'ai-coding': 'AI & CODING', 'developer-productivity': 'DEV PRODUCTIVITY',
    'typescript-javascript': 'TYPESCRIPT / JAVASCRIPT', 'general': 'GENERAL', 'other': 'OTHER',
  };
  const CAT_ORDER = Object.keys(CATS);

  class AuthError extends Error {}

  async function api(path: string, init: RequestInit = {}) {
    const res = await fetch(API + path, {
      ...init,
      credentials: 'include',
      headers: { 'X-Requested-With': 'dd', ...(init.body ? { 'Content-Type': 'application/json' } : {}) },
    });
    let data: any = null;
    try { data = await res.json(); } catch {}
    if (res.status === 401 && !path.startsWith('/auth/login')) throw new AuthError();
    return { res, data };
  }

  function show(view: 'loading' | 'login' | 'content') {
    for (const v of ['loading', 'login', 'content']) $('dd-' + v).hidden = v !== view;
    $('dd-logout').hidden = view !== 'content';
    $('dd-private').hidden = view === 'content';
    if (view === 'login') ($('dd-password') as HTMLInputElement).focus();
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function safeUrl(u: string | null | undefined) {
    try { const p = new URL(u || ''); return p.protocol === 'https:' || p.protocol === 'http:' ? p.href : null; } catch { return null; }
  }

  function prettyDate(d: string) {
    const [y, m, day] = d.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, day)).toLocaleDateString('en-GB', {
      weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC',
    }).replace(/,/g, '').toUpperCase();
  }

  function statusLabel(r: any) {
    switch (r.status) {
      case 'unread': return 'IN UNREAD';
      case 'archive': return 'ARCHIVED';
      case 'bookmarks': return 'BOOKMARKED';
      case 'other': return ('IN ' + (r.collection || 'RAINDROP')).toUpperCase();
      default: return null;
    }
  }

  function renderArticle(a: any) {
    const card = el('article', 'dd-card');
    const media = el('div', 'dd-media');
    const link = safeUrl(a.url);
    const img = safeUrl(a.og_image_url);
    const placeholder = () => {
      media.replaceChildren(el('span', 'dd-ph', (CATS[a.category] || 'ARTICLE').slice(0, 2)));
      media.classList.add('dd-media-ph');
    };
    if (img) {
      const i = document.createElement('img');
      i.src = img; i.alt = ''; i.loading = 'lazy'; i.referrerPolicy = 'no-referrer'; i.decoding = 'async';
      i.addEventListener('error', placeholder, { once: true });
      media.append(i);
    } else placeholder();

    const copy = el('div', 'dd-copy');
    const meta = el('div', 'dd-meta');
    if (a.source) meta.append(el('span', '', String(a.source).toUpperCase()));
    meta.append(el('span', '', (CATS[a.category] || 'ARTICLE')));
    const h = el('h3');
    if (link) { const t = el('a', '', a.title); t.href = link; t.target = '_blank'; t.rel = 'noopener noreferrer'; h.append(t); } else h.textContent = a.title;
    copy.append(meta, h);
    if (a.description) copy.append(el('p', 'dd-summary', a.description));
    if (a.reason) copy.append(el('p', 'dd-reason', a.reason));

    const actions = el('div', 'dd-actions');
    const renderAction = () => {
      actions.replaceChildren();
      const label = statusLabel(a.raindrop);
      if (label) { actions.append(el('span', 'dd-chip', label)); return; }
      const btn = el('button', 'dd-save', 'SAVE TO UNREAD ');
      btn.type = 'button';
      btn.append(el('b', '', '+'));
      const err = el('span', 'dd-mono dd-error', '');
      btn.addEventListener('click', async () => {
        btn.disabled = true; btn.firstChild!.textContent = 'SAVING… '; err.textContent = '';
        try {
          const { res, data } = await api(`/articles/${a.id}/save`, { method: 'POST' });
          if (!res.ok) throw new Error(data?.error || 'FAILED');
          a.raindrop = data.raindrop;
          renderAction();
        } catch (e) {
          if (e instanceof AuthError) { show('login'); return; }
          btn.disabled = false; btn.firstChild!.textContent = 'RETRY '; err.textContent = 'COULD NOT SAVE';
        }
      });
      actions.append(btn, err);
    };
    renderAction();
    copy.append(actions);
    card.append(media, copy);
    return card;
  }

  function render(data: any) {
    const arts: any[] = data.articles || [];
    $('dd-date').textContent = prettyDate(data.date);
    $('dd-count').textContent = `${arts.length} ${arts.length === 1 ? 'ARTICLE' : 'ARTICLES'}`;
    $('dd-stale').hidden = !data.status_stale;
    $('dd-empty').hidden = arts.length > 0;
    const groups = $('dd-groups');
    groups.replaceChildren();
    let n = 0;
    const cats = CAT_ORDER.filter((c) => arts.some((a) => a.category === c))
      .concat([...new Set(arts.map((a) => a.category))].filter((c) => !CAT_ORDER.includes(c)));
    for (const c of cats) {
      const section = el('section', 'dd-group');
      const rule = el('div', 'dd-grouprule dd-mono');
      rule.append(el('span', '', String(++n).padStart(2, '0')), el('span', 'dd-rule'), el('span', '', CATS[c] || c.toUpperCase()));
      section.append(rule);
      for (const a of arts.filter((x) => x.category === c)) section.append(renderArticle(a));
      groups.append(section);
    }
  }

  async function loadDigest(refresh = false) {
    const { res, data } = await api('/digests/today' + (refresh ? '?refresh=1' : ''));
    if (!res.ok) throw new Error('load failed');
    render(data);
    show('content');
  }

  async function boot() {
    try { await loadDigest(); }
    catch (e) {
      if (e instanceof AuthError) show('login');
      else { show('content'); $('dd-empty').hidden = false; $('dd-empty').firstElementChild!.textContent = 'Could not reach the digest API. Try again shortly.'; }
    }
  }

  $('dd-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const input = $('dd-password') as HTMLInputElement;
    const btn = $('dd-submit') as HTMLButtonElement;
    const err = $('dd-login-error');
    err.hidden = true; btn.disabled = true;
    try {
      const { res, data } = await api('/auth/login', { method: 'POST', body: JSON.stringify({ password: input.value }) });
      if (!res.ok) {
        err.textContent = res.status === 429 ? 'TOO MANY ATTEMPTS — TRY LATER' : res.status === 401 ? 'WRONG PASSWORD' : (data?.error || 'LOGIN FAILED').toUpperCase();
        err.hidden = false; input.select(); return;
      }
      input.value = '';
      show('loading');
      await boot();
    } catch { err.textContent = 'CANNOT REACH SERVER'; err.hidden = false; }
    finally { btn.disabled = false; }
  });

  $('dd-logout').addEventListener('click', async () => {
    try { await api('/auth/logout', { method: 'POST' }); } catch {}
    $('dd-groups').replaceChildren();
    show('login');
  });

  $('dd-refresh').addEventListener('click', async () => {
    const b = $('dd-refresh') as HTMLButtonElement;
    b.disabled = true; b.textContent = 'REFRESHING…';
    try { await loadDigest(true); } catch (e) { if (e instanceof AuthError) show('login'); }
    b.disabled = false; b.textContent = 'REFRESH STATUS';
  });

  boot();
</script>

<style is:global>
  html { background:#121412; }
  body { margin:0; background:#121412; color:#f2efdf; }
  * { box-sizing:border-box; }
  ::selection { background:#f1eb5a; color:#171916; }
  [hidden] { display:none !important; }
  .dd { --ink:#f2efdf; --muted:#a8aa9f; --dim:#777a70; --line:#343730; --acid:#f1eb5a; min-height:100svh; display:flex; flex-direction:column; padding:0 clamp(22px,8vw,124px); background:radial-gradient(ellipse at 75% 24%,#20231c 0,transparent 38%),#121412; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  .dd-topbar { height:76px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #ffffff18; }
  .dd-brand { display:flex; align-items:center; gap:10px; color:var(--ink); text-decoration:none; font-size:9px; font-weight:700; letter-spacing:.17em; }
  .dd-mark { width:30px; height:30px; display:grid; place-items:center; border:1px solid #f1eb5a80; border-radius:50%; color:var(--acid); font:14px Georgia,serif; letter-spacing:-.08em; }
  .dd-brand i { color:var(--acid); font-style:normal; margin:0 3px; }
  .dd-mono,.dd-note,.dd-ghost,.dd-meta,.dd-chip,.dd-save,.dd-footer,.dd-field button,.dd-grouprule { font-family:"Azeret Mono",ui-monospace,SFMono-Regular,monospace; letter-spacing:.13em; }
  .dd-note { color:#777a70; font-size:8px; }
  .dd-ghost { background:none; border:1px solid #ffffff22; color:var(--muted); font-size:8px; padding:9px 13px; cursor:pointer; transition:border-color .2s,color .2s; }
  .dd-ghost:hover:not(:disabled) { border-color:#f1eb5a75; color:var(--acid); }
  .dd-ghost:disabled { opacity:.5; cursor:default; }
  .dd-center { flex:1; display:grid; place-items:center; padding:60px 0; }
  .dd-pulse { color:var(--dim); font-size:9px; animation:dd-pulse 1.4s ease-in-out infinite; }
  @keyframes dd-pulse { 50% { opacity:.35; } }
  .dd h1 { margin:22px 0 0; color:var(--ink); font-size:clamp(54px,9vw,96px); font-weight:560; line-height:.95; letter-spacing:-.085em; }
  .dd h1 em { color:var(--acid); font-family:Georgia,"Times New Roman",serif; font-weight:400; letter-spacing:-.07em; }
  .dd-kicker { display:flex; align-items:center; gap:12px; margin:0; color:#777a70; font-size:8px; }
  .dd-kicker span:first-child { color:var(--acid); }
  .dd-rule { height:1px; width:58px; background:#66695e; display:inline-block; }
  .dd-login { width:min(100%,440px); }
  .dd-login form { margin-top:38px; }
  .dd-login label { display:block; color:var(--dim); font-size:8px; margin-bottom:10px; }
  .dd-field { display:flex; border:1px solid #ffffff22; background:#191b18; transition:border-color .2s; }
  .dd-field:focus-within { border-color:#f1eb5a75; }
  .dd-field input { flex:1; min-width:0; background:none; border:0; outline:0; color:var(--ink); font:16px Inter,system-ui,sans-serif; padding:15px 16px; }
  .dd-field button { background:var(--acid); color:#171916; border:0; padding:0 20px; font-size:8px; font-weight:700; cursor:pointer; }
  .dd-field button:disabled { opacity:.6; cursor:default; }
  .dd-field button b { font:14px system-ui,sans-serif; margin-left:6px; }
  .dd-error { color:#ff8f7a; font-size:8px; margin:14px 0 0; }
  .dd-warn { color:#d9b36a; font-size:8px; }
  .dd-head { width:min(100%,980px); margin:clamp(54px,9vh,100px) auto 38px; }
  .dd-head-actions { display:flex; align-items:center; gap:18px; margin-top:30px; flex-wrap:wrap; }
  #dd-content { width:100%; }
  #dd-groups, .dd-empty { width:min(100%,980px); margin:0 auto; }
  .dd-empty { border:1px solid #ffffff18; background:#191b18; padding:44px 30px; color:var(--muted); }
  .dd-empty p { margin:0 0 10px; font-size:15px; } .dd-empty .dd-mono { color:var(--dim); font-size:8px; }
  .dd-group { margin-bottom:46px; }
  .dd-grouprule { display:flex; align-items:center; gap:12px; margin-bottom:18px; color:#777a70; font-size:8px; }
  .dd-grouprule span:first-child { color:var(--acid); }
  .dd-card { display:grid; grid-template-columns:.62fr 1.38fr; border:1px solid #ffffff18; background:#191b18; margin-bottom:14px; transition:border-color .2s ease,background .2s ease; }
  .dd-card:hover { border-color:#f1eb5a55; background:#1d201b; }
  .dd-media { position:relative; min-height:170px; overflow:hidden; border-right:1px solid #ffffff12; background:#171916; }
  .dd-media img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .dd-media-ph { display:grid; place-items:center; background:radial-gradient(circle at 50% 48%,#2b2e24 0,#1b1e19 52%,#171916 100%); }
  .dd-ph { color:#f1eb5a66; font:44px Georgia,serif; letter-spacing:-.08em; }
  .dd-copy { padding:24px clamp(20px,3vw,36px); display:flex; flex-direction:column; align-items:flex-start; }
  .dd-meta { display:flex; flex-wrap:wrap; gap:12px; color:#85877d; font-size:7px; }
  .dd-meta span+span::before { content:"/"; margin-right:12px; color:#56594f; }
  .dd-copy h3 { margin:14px 0 10px; font-size:clamp(19px,2.4vw,25px); font-weight:560; line-height:1.18; letter-spacing:-.035em; }
  .dd-copy h3 a { color:var(--ink); text-decoration:none; } .dd-copy h3 a:hover { color:var(--acid); }
  .dd-copy h3 a:focus-visible { outline:2px solid var(--acid); outline-offset:3px; }
  .dd-summary { margin:0; color:#aeb0a5; font-size:13px; line-height:1.7; }
  .dd-reason { margin:10px 0 0; color:#85877d; font-size:12px; line-height:1.6; font-style:italic; }
  .dd-actions { margin-top:auto; padding-top:20px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
  .dd-save { background:none; border:1px solid #f1eb5a66; color:var(--acid); font-size:8px; padding:10px 14px; cursor:pointer; transition:background .2s,color .2s; }
  .dd-save:hover:not(:disabled) { background:var(--acid); color:#171916; }
  .dd-save:disabled { opacity:.6; cursor:default; }
  .dd-save b { font:13px system-ui,sans-serif; margin-left:4px; }
  .dd-chip { color:#8f9285; font-size:8px; border:1px solid #ffffff1f; padding:8px 12px; }
  .dd-footer { margin:54px auto 0; width:min(100%,980px); min-height:57px; border-top:1px solid #ffffff18; display:flex; justify-content:space-between; align-items:center; color:#686b61; font-size:7px; }
  @media(max-width:640px) {
    .dd { padding:0 21px; }
    .dd-topbar { height:64px; }
    .dd-head { margin:60px auto 30px; }
    .dd-card { grid-template-columns:1fr; }
    .dd-media { min-height:0; aspect-ratio:16/9; border-right:0; border-bottom:1px solid #ffffff12; }
    .dd-copy { padding:20px 20px 22px; }
    .dd-footer { margin-top:42px; font-size:6px; }
  }
  @media(prefers-reduced-motion:reduce) { .dd-card,.dd-save,.dd-ghost,.dd-pulse { transition:none; animation:none; } }
</style>
