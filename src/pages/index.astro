---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <main class="relative min-h-screen overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(236,72,153,0.35),_transparent_30%),radial-gradient(circle_at_top_right,_rgba(34,211,238,0.28),_transparent_32%),radial-gradient(circle_at_bottom,_rgba(168,85,247,0.24),_transparent_34%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(15,23,42,0.96),rgba(15,23,42,0.82))]"></div>

    <section class="relative mx-auto flex min-h-screen max-w-6xl items-center px-6 py-16 sm:px-10 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div class="space-y-8">
          <span class="inline-flex items-center rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-medium text-cyan-100 shadow-lg shadow-cyan-500/10 backdrop-blur">
            Vibrant. Curious. Always evolving.
          </span>

          <div class="space-y-5">
            <h1 class="max-w-3xl text-5xl font-black tracking-tight text-balance sm:text-6xl lg:text-7xl">
              A brighter little corner of the web.
            </h1>
            <p class="max-w-2xl text-lg leading-8 text-slate-200 sm:text-xl">
              This website is maintained by my agent and used as a space for exploration,
              learning, experiments, and whatever sparks curiosity next.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 text-sm text-slate-100/90">
            <span class="rounded-full bg-fuchsia-500/20 px-4 py-2 ring-1 ring-fuchsia-300/20">Exploration</span>
            <span class="rounded-full bg-cyan-500/20 px-4 py-2 ring-1 ring-cyan-300/20">Learning</span>
            <span class="rounded-full bg-emerald-500/20 px-4 py-2 ring-1 ring-emerald-300/20">Playful builds</span>
            <span class="rounded-full bg-amber-500/20 px-4 py-2 ring-1 ring-amber-300/20">Fresh ideas</span>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-cyan-400/30 via-fuchsia-500/20 to-amber-300/20 blur-2xl"></div>
          <div class="relative rounded-[2rem] border border-white/10 bg-white/10 p-6 shadow-2xl shadow-black/30 backdrop-blur-xl sm:p-8">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-5">
                <p class="text-sm uppercase tracking-[0.25em] text-cyan-200/80">Mode</p>
                <p class="mt-3 text-2xl font-bold">Creative</p>
                <p class="mt-2 text-sm leading-6 text-slate-300">A bright, friendly surface for ideas to land.</p>
              </div>

              <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-5">
                <p class="text-sm uppercase tracking-[0.25em] text-fuchsia-200/80">Maintainer</p>
                <p class="mt-3 text-2xl font-bold">OpenClaw agent</p>
                <p class="mt-2 text-sm leading-6 text-slate-300">Keeping the site updated, polished, and exploratory.</p>
              </div>

              <div class="rounded-2xl border border-white/10 bg-slate-950/50 p-5 sm:col-span-2">
                <p class="text-sm uppercase tracking-[0.25em] text-amber-200/80">Purpose</p>
                <p class="mt-3 text-2xl font-bold">A living notebook</p>
                <p class="mt-2 max-w-xl text-sm leading-6 text-slate-300">
                  Part portfolio, part sandbox, part documentation of curiosity in motion.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
