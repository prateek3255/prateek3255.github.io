---
import Layout from '../layouts/Layout.astro';

const compounds = [
  { code: 'C1', label: 'Hardest', note: 'Built for severe loads and long stints.', color: 'var(--c1)', width: '100%' },
  { code: 'C2', label: 'Hard', note: 'A durable option when the circuit is demanding.', color: 'var(--c2)', width: '82%' },
  { code: 'C3', label: 'Middle', note: 'A versatile step between durability and grip.', color: 'var(--c3)', width: '64%' },
  { code: 'C4', label: 'Soft', note: 'More grip and response, usually less life.', color: 'var(--c4)', width: '45%' },
  { code: 'C5', label: 'Softest', note: 'Maximum bite for a short, fast run.', color: 'var(--c5)', width: '28%' },
];

const degradation = [
  { n: '01', title: 'Wear', tag: 'Rubber used up', text: 'Every lap abrades and shears away rubber. As the tread thins, the tyre has less rubber to work with and grip falls away.' },
  { n: '02', title: 'Thermal fade', tag: 'Too hot for too long', text: 'Repeated braking, cornering and acceleration put energy into the tyre. Outside its useful temperature window, the compound loses performance faster.' },
  { n: '03', title: 'Graining', tag: 'Surface slips and tears', text: 'When the carcass is cool but the tread surface is hotter, the surface can slide, wrinkle and shed little rolls of rubber. The roughened surface costs grip; it may improve if the tyre settles back into its window.' },
  { n: '04', title: 'Blistering', tag: 'Heat from within', text: 'Excess heat inside the tyre can form bubbles beneath the surface. When they break away, chunks of rubber go with them and the damage is difficult to recover from.' },
];
---

<Layout title="F1 Tyres, Explained — Prateek's Garage Notes">
  <main class="guide">
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Back to Prateek's site"><span class="mark">P.</span><span>GARAGE NOTES</span></a>
      <a class="top-link" href="#quick-answer">Start with the quick answer <span aria-hidden="true">↘</span></a>
    </header>

    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> THE RACE-WEEKEND FIELD GUIDE <span class="eyebrow-year">2026</span></p>
        <h1 id="page-title">F1 tyres,<br /><em>explained.</em></h1>
        <p class="hero-deck">Four small contact patches. An enormous part of the race. Here’s how the rubber shapes grip, pace and every pit-wall decision.</p>
        <a class="hero-cta" href="#quick-answer">Get up to speed <span aria-hidden="true">↓</span></a>
        <div class="hero-meta"><span>8 MIN READ</span><span class="meta-line"></span><span>NO ENGINEERING DEGREE REQUIRED</span></div>
      </div>
      <div class="hero-art" aria-label="Illustration of a Formula 1 tyre with grip and heat lines" role="img">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <svg class="hero-wheel" viewBox="0 0 440 440" aria-hidden="true">
          <defs>
            <linearGradient id="rubber" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#41443e"/><stop offset=".48" stop-color="#181a18"/><stop offset="1" stop-color="#090b0a"/></linearGradient>
            <linearGradient id="rim" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbf4e8"/><stop offset=".45" stop-color="#aca99d"/><stop offset="1" stop-color="#f8f2e6"/></linearGradient>
            <filter id="wheel-shadow" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="28" stdDeviation="20" flood-color="#000" flood-opacity=".55"/></filter>
          </defs>
          <g transform="rotate(-17 220 220)" filter="url(#wheel-shadow)">
            <circle cx="220" cy="220" r="169" fill="url(#rubber)" stroke="#565950" stroke-width="3"/>
            <circle cx="220" cy="220" r="143" fill="none" stroke="#0b0d0b" stroke-width="10"/>
            <circle cx="220" cy="220" r="125" fill="#242722" stroke="#797b70" stroke-width="2"/>
            <circle cx="220" cy="220" r="101" fill="url(#rim)"/>
            <circle cx="220" cy="220" r="76" fill="#222622"/>
            <circle cx="220" cy="220" r="28" fill="#d9d2c2"/>
            <circle cx="220" cy="220" r="14" fill="#1d211d"/>
            {Array.from({ length: 10 }, (_, i) => <g transform={`rotate(${i * 36} 220 220)`}><path d="M220 120 L220 198" stroke="#c8c5b8" stroke-width="8" stroke-linecap="round"/><circle cx="220" cy="154" r="5" fill="#252923"/></g>)}
            {Array.from({ length: 24 }, (_, i) => <path transform={`rotate(${i * 15} 220 220)`} d="M214 57 L218 75" stroke="#77796e" stroke-width="2" opacity=".6"/>)}
            <path d="M92 135 A165 165 0 0 1 159 75" fill="none" stroke="#f1eb5a" stroke-width="5" stroke-linecap="round"/>
          </g>
        </svg>
        <span class="art-label label-grip">GRIP <i>↗</i></span>
        <span class="art-label label-heat">HEAT <i>↘</i></span>
        <span class="art-caption">THE ONLY THING<br />BETWEEN CAR &amp; CIRCUIT</span>
        <svg class="track-line" viewBox="0 0 175 84" fill="none" aria-hidden="true"><path d="M5 70h32l17-42h30l13 22h34l17-38h22" stroke="#f1eb5a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="52" cy="28" r="4" fill="#f1eb5a"/><circle cx="148" cy="12" r="4" fill="#f1eb5a"/></svg>
      </div>
      <div class="hero-bottom"><span>01 / THE BASICS</span><span>SCROLL TO EXPLORE <b>↓</b></span></div>
    </section>

    <section class="quick section-shell" id="quick-answer">
      <div class="section-kicker"><span>THE SHORT VERSION</span><span>01—05</span></div>
      <div class="quick-grid">
        <div><p class="section-label">SO, WHAT DO THEY DO?</p><h2>They turn horsepower<br />into <em>corner speed.</em></h2></div>
        <div class="quick-copy"><p>Tyres are the car’s only contact with the track. Their compound and temperature decide how much braking, cornering and acceleration force the car can put down—and for how long.</p><p>That makes a tyre choice a trade: <strong>more grip now</strong> usually means <strong>less performance later.</strong> Teams manage that trade every lap.</p></div>
      </div>
      <div class="stat-strip">
        <div class="stat"><strong>4</strong><span>tyres on the car</span></div><div class="stat"><strong>13</strong><span>dry sets in a standard GP</span></div><div class="stat"><strong>5</strong><span>slick compounds in 2026</span></div><div class="stat"><strong>1</strong><span>supplier: Pirelli</span></div>
      </div>
    </section>

    <section class="anatomy section-shell" id="anatomy">
      <div class="section-kicker"><span>WHY RUBBER MATTERS</span><span>02—05</span></div>
      <div class="section-heading"><div><p class="section-label">THE CONTACT PATCH</p><h2>A tiny footprint.<br /><em>A massive job.</em></h2></div><p class="section-intro">All the car’s forces have to pass through four patches of rubber. More grip means the tyre can push harder against the track before it slides.</p></div>
      <div class="diagram-card">
        <div class="diagram-top"><span>TOP-DOWN VIEW / NOT TO SCALE</span><span class="diagram-key"><i></i> CONTACT PATCH</span></div>
        <svg class="patch-diagram" viewBox="0 0 900 315" role="img" aria-label="Top-down illustration of an F1 car with four small contact patches touching the track">
          <defs><pattern id="asphalt" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="3" cy="4" r=".8" fill="#74766a" opacity=".3"/><circle cx="14" cy="13" r=".7" fill="#74766a" opacity=".24"/></pattern></defs>
          <rect width="900" height="315" fill="url(#asphalt)"/>
          <path d="M72 86h756M72 229h756" stroke="#6a6c61" stroke-width="1" stroke-dasharray="5 10" opacity=".45"/>
          <g transform="translate(450 157) rotate(-90)">
            <path d="M-123 -25 Q-88 -36 -50 -30 L14 -29 Q79 -34 114 -19 L137 0 L114 19 Q78 34 14 29 L-50 30 Q-88 36 -123 25 L-147 14 L-147 -14Z" fill="#b9b7a8"/>
            <path d="M-92 -29 L-70 -52 L-37 -50 L-40 -28M-92 29 L-70 52 L-37 50 L-40 28M54 -31 L78 -56 L111 -49 L100 -23M54 31 L78 56 L111 49 L100 23" fill="#73766b"/>
            <path d="M-22 -29 L14 -52 L52 -47 L62 -27 L62 27 L52 47 L14 52 L-22 29Z" fill="#f1eb5a"/>
            <path d="M-10 -17 L37 -17 L50 -8 L50 8 L37 17 L-10 17Z" fill="#252923"/>
            <rect x="-118" y="-53" width="62" height="18" rx="6" fill="#171917"/><rect x="-118" y="35" width="62" height="18" rx="6" fill="#171917"/>
            <rect x="78" y="-58" width="65" height="20" rx="7" fill="#171917"/><rect x="78" y="38" width="65" height="20" rx="7" fill="#171917"/>
            <rect x="-109" y="-53" width="44" height="18" rx="6" fill="#f1eb5a"/><rect x="-109" y="35" width="44" height="18" rx="6" fill="#f1eb5a"/>
            <rect x="87" y="-58" width="48" height="20" rx="7" fill="#f1eb5a"/><rect x="87" y="38" width="48" height="20" rx="7" fill="#f1eb5a"/>
          </g>
          <path d="M235 68h105l70 50" stroke="#f1eb5a" stroke-width="1.5" fill="none"/><circle cx="410" cy="118" r="3" fill="#f1eb5a"/>
          <text x="76" y="58" fill="#f1eb5a" font-size="12" letter-spacing="2" font-family="monospace">FOUR CONTACT PATCHES</text>
          <text x="635" y="270" fill="#aaa99d" font-size="12" letter-spacing="1.5" font-family="monospace">EVERY FORCE PASSES THROUGH HERE</text>
        </svg>
        <div class="diagram-caption"><span>At speed, the tyre deforms under load—then springs back, lap after lap.</span><span>ILLUSTRATION / PRATEEK’S GARAGE NOTES</span></div>
      </div>
    </section>

    <section class="allocation section-shell" id="allocation">
      <div class="section-kicker"><span>THE WEEKEND ALLOCATION</span><span>03—05</span></div>
      <div class="section-heading"><div><p class="section-label">HOW MANY DO THEY GET?</p><h2>A lot of rubber.<br /><em>Not unlimited.</em></h2></div><p class="section-intro">The FIA and Pirelli set a controlled allocation for each driver. Teams have to choose, save and return sets as the weekend unfolds.</p></div>
      <div class="allocation-grid">
        <article class="allocation-main">
          <div class="allocation-number">13<span>SETS</span></div>
          <div class="allocation-text"><h3>Dry tyres per driver</h3><p>On a standard 2026 Grand Prix weekend, each driver has <strong>13 sets of slicks</strong>: typically two Hard, three Medium and eight Soft. One set means four tyres—so that’s up to 52 dry tyres allocated to one driver across the weekend.</p></div>
          <div class="allocation-bars" aria-label="Typical dry tyre set allocation: two hard, three medium, eight soft">
            <div class="alloc-row"><span>HARD</span><div class="bar hard-bar"><i></i><i></i></div><b>2</b></div>
            <div class="alloc-row"><span>MEDIUM</span><div class="bar medium-bar"><i></i><i></i><i></i></div><b>3</b></div>
            <div class="alloc-row"><span>SOFT</span><div class="bar soft-bar"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><b>8</b></div>
          </div>
          <div class="allocation-footnote">SPRINT WEEKENDS: 12 DRY SETS · 2 HARD + 4 MEDIUM + 6 SOFT</div>
        </article>
        <aside class="wet-card">
          <div class="wet-heading"><span class="rain-icon">☂</span><span>WHEN IT RAINS</span></div>
          <h3>Two more tyre types.<br />A whole different race.</h3>
          <div class="wet-type"><span class="wet-swatch inter"></span><div><strong>Intermediate</strong><p>Green · for a damp or drying track, with standing water limited.</p></div></div>
          <div class="wet-type"><span class="wet-swatch full"></span><div><strong>Full wet</strong><p>Blue · deeper tread to move more water in heavy rain.</p></div></div>
          <p class="wet-note">Rain-tyre quantities are separate from the 13 slick sets; exact weekend allocations can vary with the format and regulations.</p>
        </aside>
      </div>
      <p class="allocation-caveat"><span>NOTE</span> Allocation is not the same as tyres used: teams return nominated sets after sessions, and weather and Sprint rules change the details. A dry Grand Prix also generally requires drivers to race on at least two slick compounds.</p>
    </section>

    <section class="compounds section-shell" id="compounds">
      <div class="section-kicker"><span>COMPOUNDS & COLOURS</span><span>04—05</span></div>
      <div class="section-heading"><div><p class="section-label">FIVE SLICKS. THREE AT EACH RACE.</p><h2>Same family.<br /><em>Different trade-offs.</em></h2></div><p class="section-intro">Pirelli’s 2026 dry range runs from C1 (hardest) to C5 (softest). For each Grand Prix, it picks three options to suit the circuit.</p></div>
      <div class="compound-layout">
        <div class="compound-scale">
          <div class="scale-labels"><span>LONGER LIFE</span><span>MORE GRIP</span></div>
          {compounds.map((tire) => (
            <div class="compound-row">
              <div class="compound-id"><span class="compound-dot" style={`--dot:${tire.color}`}></span><strong>{tire.code}</strong><small>{tire.label}</small></div>
              <div class="compound-track"><span style={`--level:${tire.width};--compound:${tire.color}`}></span></div>
              <p>{tire.note}</p>
            </div>
          ))}
          <div class="scale-caption"><span>MORE DURABLE</span><span>SOFTER / SHORTER STINT</span></div>
        </div>
        <aside class="compound-aside">
          <div class="color-card">
            <p class="section-label">WHAT THE COLOURS MEAN</p>
            <div class="color-line"><span class="color-chip white-chip">H</span><div><strong>Hard · white</strong><p>Most durable of that weekend’s three.</p></div></div>
            <div class="color-line"><span class="color-chip yellow-chip">M</span><div><strong>Medium · yellow</strong><p>The middle ground for pace and life.</p></div></div>
            <div class="color-line"><span class="color-chip red-chip">S</span><div><strong>Soft · red</strong><p>Usually the quickest, often the shortest-lived.</p></div></div>
          </div>
          <div class="key-insight"><span class="insight-star">✳</span><p><strong>Hard, Medium and Soft are weekend labels—not fixed recipes.</strong> A “Hard” can be C1 at one circuit and C3 at another. The same colour always tells you its role in that event’s selected trio.</p></div>
        </aside>
      </div>
      <div class="compound-note"><span class="note-arrow">↗</span><p><strong>Why not bring all five?</strong> A circuit’s surface, corner speeds, temperatures and load decide which three compounds Pirelli selects. Sometimes the choices are adjacent in the range; sometimes they skip a step to create a bigger strategic contrast.</p></div>
    </section>

    <section class="degradation section-shell" id="degradation">
      <div class="section-kicker"><span>DEGRADATION, WITHOUT THE JARGON</span><span>05—05</span></div>
      <div class="section-heading"><div><p class="section-label">WHY TYRES SLOW DOWN</p><h2>Grip is a budget.<br /><em>Every lap spends it.</em></h2></div><p class="section-intro">“Degradation” means performance fading over a stint. It can be gradual—or arrive suddenly when a tyre is pushed outside its happy range.</p></div>
      <div class="degradation-feature">
        <div class="pace-chart">
          <div class="chart-caption"><span>ILLUSTRATIVE PACE THROUGH A STINT</span><span>FASTER ↑</span></div>
          <svg viewBox="0 0 520 260" role="img" aria-label="Illustrative chart showing lap pace gradually falling as a tyre degrades, followed by a pit stop reset">
            <path d="M42 28v186h445" stroke="#62645a" stroke-width="1" fill="none"/>
            <path d="M43 56h444M43 106h444M43 156h444M43 206h444" stroke="#4a4c44" stroke-width="1" stroke-dasharray="3 7"/>
            <path d="M47 56 C98 63 115 68 148 78 S202 95 226 105 S285 127 310 134 S348 147 374 157" stroke="#f1eb5a" stroke-width="4" fill="none" stroke-linecap="round"/>
            <path d="M374 157 L405 54 C430 58 457 61 484 69" stroke="#83cbb7" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M374 157v52" stroke="#83cbb7" stroke-width="1.5" stroke-dasharray="3 5"/>
            <circle cx="374" cy="157" r="5" fill="#83cbb7"/><text x="355" y="230" fill="#83cbb7" font-size="10" letter-spacing="1.4" font-family="monospace">PIT</text>
            <text x="48" y="247" fill="#a8a99e" font-size="10" letter-spacing="1.2" font-family="monospace">LAPS ON TYRE →</text>
            <text x="57" y="48" fill="#a8a99e" font-size="10" letter-spacing="1.1" font-family="monospace">NEW TYRE</text>
            <text x="412" y="42" fill="#83cbb7" font-size="10" letter-spacing="1.1" font-family="monospace">FRESH RUBBER</text>
          </svg>
          <p>The pit stop resets the tyre—not the race clock. A faster tyre may be worth the time lost in the pit lane.</p>
        </div>
        <div class="degradation-intro"><span class="heat-mark">∿</span><p>The tyre heats, flexes and scrubs against the asphalt on every lap. Teams aim for its <strong>working window</strong>: too cool and it struggles to grip; too hot and it can overheat, wear or break up.</p><p>Drivers manage that temperature with braking, steering, throttle and sometimes by easing off for a few corners. This is why a lap can be quick without being the fastest possible lap.</p></div>
      </div>
      <div class="degradation-grid">
        {degradation.map((item) => (
          <article class="degrade-card"><div class="degrade-top"><span>{item.n}</span><span>{item.tag}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>
        ))}
      </div>
      <div class="strategy-band"><div class="strategy-mark">PIT<br />WALL<br /><span>↗</span></div><div><p class="section-label">THE STRATEGY IN ONE SENTENCE</p><h3>How long can you stay fast—and what will a fresh set buy you?</h3><p>That’s the tyre question behind an undercut, an overcut, a one-stop and a late-race charge.</p></div></div>
    </section>

    <section class="road section-shell" id="road-tyres">
      <div class="section-kicker"><span>F1 VS. ROAD TYRES</span><span>EXTRA LAP</span></div>
      <div class="section-heading"><div><p class="section-label">BUILT FOR DIFFERENT LIVES</p><h2>A race tyre isn’t<br /><em>a road tyre in red.</em></h2></div><p class="section-intro">One is tuned for a narrow, high-performance job on a circuit. The other needs to be dependable through seasons, storms and school runs.</p></div>
      <div class="road-grid">
        <article class="road-card f1-road-card"><div class="road-card-top"><span>01 / F1 SLICK</span><span class="road-tire tire-slick" aria-hidden="true"></span></div><h3>Peak grip.<br />Narrow purpose.</h3><ul><li>Smooth tread for maximum dry contact</li><li>Designed to work in a carefully managed temperature range</li><li>Optimised for race pace, not thousands of road kilometres</li><li>Intermediate and full-wet designs for rain</li></ul></article>
        <article class="road-card street-road-card"><div class="road-card-top"><span>02 / ROAD TYRE</span><span class="road-tire tire-road" aria-hidden="true"></span></div><h3>All-weather.<br />Long-distance.</h3><ul><li>Grooves channel water and help resist aquaplaning</li><li>Compound works across a much wider range of conditions</li><li>Designed for wear life, comfort, noise and everyday safety</li><li>Built for public roads and changing surfaces</li></ul></article>
      </div>
      <p class="road-takeaway"><span>THE TAKEAWAY</span> F1 slicks are extraordinary specialist tools—not a practical or road-legal upgrade for an ordinary car.</p>
    </section>

    <section class="finale">
      <div class="finale-inner"><p class="eyebrow"><span class="live-dot"></span> NOW YOU’RE IN THE PIT LANE</p><h2>Four patches.<br /><em>A thousand decisions.</em></h2><p>Next time a driver pits, watch the tyres. That fresh set isn’t just a replacement—it’s a new strategy.</p><a href="#page-title" class="back-top">BACK TO THE TOP <span>↑</span></a></div>
      <div class="finale-wheel" aria-hidden="true">P</div>
    </section>

    <footer class="page-footer">
      <div><a class="wordmark" href="/"><span class="mark">P.</span><span>GARAGE NOTES</span></a><p>A curious fan’s guide. Facts checked against current 2026 F1 and Pirelli material.</p></div>
      <div class="sources"><span>FURTHER READING</span><a href="https://www.formula1.com/en/latest/article/the-beginners-guide-to-formula-1-tyres.61SvF0Kfg29UR2SPhakDqd" target="_blank" rel="noreferrer">Formula 1 · Beginner’s guide to tyres ↗</a><a href="https://press.pirelli.com/the-range-of-compounds-for-the-2026-season-has-been-set/" target="_blank" rel="noreferrer">Pirelli · 2026 compound range ↗</a><a href="https://www.formula1.com/en/latest/article/a-beginners-guide-to-f1-slang.1Pg6tvGZ2y7u4KAnc8WXGl" target="_blank" rel="noreferrer">Formula 1 · Graining &amp; blistering ↗</a><a href="https://www.formula1.com/en/latest/article/what-tyres-will-the-teams-and-drivers-have-for-the-2026-british-grand-prix.3qD9d5o8X4x3se0F7Zg5i1" target="_blank" rel="noreferrer">Formula 1 · Sprint-weekend allocation ↗</a></div>
      <div class="footer-bottom"><span>MADE FOR THE CURIOUS</span><a href="/">PRATEEK3255.GITHUB.IO ↗</a><span>2026 EDITION</span></div>
    </footer>
  </main>
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; background: #121412; }
  :global(body) { margin: 0; background: #121412; color: #f2efdf; }
  :global(*) { box-sizing: border-box; }
  :global(::selection) { background: #f1eb5a; color: #171916; }
  .guide { --ink:#f2efdf; --muted:#aaa99d; --dim:#73766c; --night:#121412; --panel:#1a1d19; --line:#353831; --acid:#f1eb5a; --mint:#83cbb7; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; overflow:hidden; background:var(--night); color:var(--ink); }
  .topbar { height:76px; padding:0 clamp(22px,6vw,96px); border-bottom:1px solid #ffffff15; display:flex; align-items:center; justify-content:space-between; position:absolute; z-index:3; top:0; left:0; right:0; }
  .wordmark { color:var(--ink); display:flex; align-items:center; gap:10px; text-decoration:none; font-size:10px; letter-spacing:.18em; font-weight:700; }
  .mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid #f1eb5a80; border-radius:50%; color:var(--acid); font-family:Georgia,serif; font-size:14px; letter-spacing:-.08em; }
  .top-link { color:#d0d0c5; text-decoration:none; font-size:12px; letter-spacing:.03em; }.top-link span { color:var(--acid); margin-left:8px; }
  .hero { background:radial-gradient(ellipse at 70% 44%, #252820 0, #151714 38%, #111310 78%); min-height:740px; padding:150px clamp(22px,8vw,132px) 72px; position:relative; display:grid; grid-template-columns:1fr 1fr; align-items:center; border-bottom:1px solid var(--line); }
